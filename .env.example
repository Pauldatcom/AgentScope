# AgentScope configuration example.
# Copy to `.env` and fill in. NEVER commit your real `.env`.

# ---- Database (PostgreSQL via docker-compose) ----
DATABASE_URL=postgresql+psycopg://agentscope:agentscope@localhost:5432/agentscope

# ---- AI provider (OpenRouter) ----
# Single key, multiple models selectable by IA_MODEL / IA_MODEL_ALT.
# Get one at https://openrouter.ai (free tier available).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Primary model used by the mapping agent.
IA_MODEL=openai/gpt-4o-mini
# Secondary model documented for the interchangeability test.
IA_MODEL_ALT=z-ai/glm-5.2

# Set to "fake" to run the deterministic stub (no network, no key).
IA_PROVIDER=openrouter

# ---- App ----
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Hide .env-backed values in the Settings UI (switch can still reveal non-secrets).
MASK_ENV=true

# Fake Slack/S3 cards in Settings. Unset = shown only when APP_ENV=development.
# ENABLE_INTEGRATIONS=false
